# Nome do banco: todos devem criar o banco com ESTE nome
DW_DB=fiscalmind_dw
DW_HOST=host.docker.internal
DW_PORT=5432
# Usuário e senha: use os seus
DW_USER=seu_usuario
DW_PASSWORD=sua_senha
# Configurações internas do Superset
SUPERSET_SECRET_KEY=gere_uma_chave_segura
SUPERSET_DB_PASSWORD=defina_uma_senha
# Administrador inicial do Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=defina_uma_senha_forte
SUPERSET_ADMIN_EMAIL=admin@fiscalmind.local